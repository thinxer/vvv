+enum Source {
+    Wayland(Capturer),
+    External(Arc<dyn super::ExternalScreen>, u64),
+}
+
+impl Source {
+    fn render_node(&self) -> &std::path::Path {
+        match self {
+            Self::Wayland(c) => c.render_node(),
+            Self::External(..) => std::path::Path::new(RENDER_NODE),
+        }
+    }
+
+    fn next_frame(&mut self, timeout: Duration) -> Result<Option<crate::capture::Frame>> {
+        match self {
+            Self::Wayland(c) => c.next_frame(Some(timeout)),
+            Self::External(s, last) => {
+                let frame = s.next_frame(*last, timeout);
+                if let Some(f) = &frame {
+                    *last = f.seq;
+                }
+                Ok(frame)
+            }
+        }
+    }
+}
