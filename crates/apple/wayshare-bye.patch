+/// Append the final BYE to a compound SR/SDES report before SRTCP protection.
+pub fn append_bye(report: &mut Vec<u8>, first: u32, count: u8) {
+    assert!((1..=31).contains(&count));
+    report.extend([0x80 | count, PT_BYE, 0, count]);
+    for tile in 0..count {
+        report.extend(first.wrapping_add(u32::from(tile)).to_be_bytes());
+    }
+}
