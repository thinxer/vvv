+            let first = if refresh { idr.as_slice() } else { inter.as_slice() };
+            let ts = if refresh { 1200 } else { 1600 };
+            let expected = whole.packetize(&[Some(first), None, Some(&inter), None], ts);
+            let mut sent = Vec::new();
+            incremental.packetize_strip(0, first, ts, refresh, false, |p| sent.push(p));
+            incremental.packetize_strip(2, &inter, ts, refresh, true, |p| sent.push(p));
+            assert_eq!(sent, expected);
+        }
+    }
